# ============================================================
# StockSense Backend Environment Template (.env.example)
# Copy to .env for local development or configure in Render Dashboard
# ============================================================

# 1. PostgreSQL Database Connection (asyncpg driver required)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db

# 2. JWT Authentication
SECRET_KEY=replace-with-a-secure-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 3. CORS Allowed Origins (comma-separated frontend URLs)
CORS_ORIGINS=http://localhost:5173,https://prod-inventory-management.vercel.app

# 4. Optional: 100% Free Low-Stock Email Alerts (Gmail SMTP App Password)
# Leave SMTP_USER / SMTP_PASSWORD blank to run in safe Console/UI Demo Mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_RECIPIENT_EMAIL=admin@stocksense.local

