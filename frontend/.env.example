# ==============================================================================
# StockSense Frontend Environment Template
# ==============================================================================
# Copy this file to .env (for local development) or configure these variables
# directly in your production hosting dashboard (e.g. Vercel, Netlify, Render).
#
# IMPORTANT SECURITY NOTES:
# - All variables starting with VITE_* are embedded into the client-side JavaScript bundle
#   at BUILD TIME.
# - NEVER put secret tokens, database passwords, or private keys into this file.
# ==============================================================================

# Base URL for the StockSense FastAPI backend.
# - Local development: http://localhost:8000
# - Production example: https://api.stocksense.yourdomain.com
# Trailing slashes are automatically sanitized by src/lib/env.ts.
VITE_API_BASE_URL=http://localhost:8000
